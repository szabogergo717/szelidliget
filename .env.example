# ============================================================
#  Szelid Liget — környezeti változók
#
#  EZ CSAK MINTA — ide soha ne írj valódi kulcsot.
#
#  Ha böngészőből dolgozol (ez az ajánlott út), ezt a fájlt hagyd
#  békén: a valódi kulcsok a Vercel "Environment Variables"
#  beállításai közé kerülnek, nem ide.
#
#  Ha a saját gépeden futtatod: másold le ".env.local" néven, és
#  abba írd a valódi értékeket. A .env.local SOHA nem kerülhet fel
#  a GitHubra (a .gitignore kizárja).
#
#  Ha egy kulcs mégis kikerül, azonnal cseréld le a szolgáltatónál —
#  a visszavonás ingyenes, a kár nem.
# ============================================================

# ---------- Supabase ----------
# A "Project Settings → API" oldalon találod mindkettőt.

# Ez a kulcs KIKERÜL a böngészőbe. Ez így van rendben: az RLS
# szabályok miatt ezzel csak a publikus adat érhető el.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ⚠ Ez a kulcs MEGKERÜLI az összes RLS szabályt: aki megszerzi,
# minden vendégadatot és foglalást lát. SOHA ne tedd "NEXT_PUBLIC_"
# előtaggal ellátott változóba, mert akkor a böngészőbe kerül.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------- SimplePay (OTP Mobil) ----------
# A kereskedői fiókodhoz kapott adatok. Először SANDBOX-szal
# dolgozz, és csak élesítéskor válts.
SIMPLEPAY_MERCHANT=PUBLICTESTHUF
SIMPLEPAY_SECRET_KEY=FxDa5w314kLlNseq2sKuVwaqZshZT5d6
SIMPLEPAY_SANDBOX=true

# ---------- Resend (e-mail) ----------
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FELADO="Szelid Liget <foglalas@szelidliget.hu>"
EMAIL_ERTESITES=szabogergo717@gmail.com

# ---------- Admin felület ----------
# A foglalások és vendégadatok kezeléséhez.
#
# ⚠ A jelszó legyen LEGALÁBB 12 karakter, és ne egyezzen semmi mással.
#   Ez védi az összes vendégadatot. Jelszókezelővel generálj egyet.
#   Ha nincs megadva, az admin felületre senki nem tud belépni.
ADMIN_JELSZO=ide-egy-hosszu-eros-jelszo

# A munkamenet aláírásához. Legalább 24 karakter, véletlenszerű.
# Ha ezt megváltoztatod, mindenki kiléptetve lesz.
ADMIN_SESSION_TITOK=ide-egy-masik-hosszu-veletlen-karaktersor

# ---------- Banki átutalás ----------
# Ha a vendég átutalást választ, ezek kerülnek az e-mailjébe.
# Amíg üresek, az utalásos foglalás létrejön, de számlaszám nélkül.
UTALAS_KEDVEZMENYEZETT=Szekundum Kft.
UTALAS_SZAMLASZAM=00000000-00000000-00000000
UTALAS_IBAN=HU00 0000 0000 0000 0000 0000 0000
# Hány napja van a vendégnek utalni:
UTALAS_HATARIDO_NAP=3

# ---------- Napi időzített feladat ----------
# Az érkezés előtti emlékeztető e-mailhez. Te találod ki; legyen
# hosszú és véletlenszerű. A Vercel ezt küldi a futtatáskor.
CRON_SECRET=ide-egy-hosszu-veletlen-karaktersor

# ---------- Cég- és kapcsolati adatok ----------
# Ezek KIKERÜLNEK a böngészőbe — a láblécben és az impresszumban
# jelennek meg, tehát nyilvános adatok.
NEXT_PUBLIC_ADOSZAM=00000000-0-00
NEXT_PUBLIC_SZEKHELY=0000 Város, Utca 1.
NEXT_PUBLIC_TELEFON=+36 30 000 0000

# ---------- Közösségi oldalak (opcionális) ----------
# Amelyik üres, az a link nem jelenik meg.
NEXT_PUBLIC_FACEBOOK=https://www.facebook.com/...
NEXT_PUBLIC_INSTAGRAM=https://www.instagram.com/...
NEXT_PUBLIC_TIKTOK=

# ---------- Háttérvideó (opcionális) ----------
# 1 = a főoldalon háttérvideó fut a logó mögött.
# Előtte tedd be a public/hero.mp4 és public/hero-poster.jpg fájlt.
# NEXT_PUBLIC_HERO_VIDEO=1

# ---------- Oldal ----------
NEXT_PUBLIC_OLDAL_URL=https://www.szelidliget.hu
