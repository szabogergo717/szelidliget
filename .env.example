# ============================================================
#  Szelid Liget — környezeti változók
#
#  EZ CSAK MINTA — ide soha ne írj valódi kulcsot.
#
#  Ha böngészőből dolgozol (ez az ajánlott út), ezt a fájlt hagyd
#  békén: a valódi kulcsok a Vercel "Environment Variables"
#  beállításai közé kerülnek, nem ide.
#
#  Ha a saját gépeden futtatod: másold le ".env.local" néven, és
#  abba írd a valódi értékeket. A .env.local SOHA nem kerülhet fel
#  a GitHubra (a .gitignore kizárja).
#
#  Ha egy kulcs mégis kikerül, azonnal cseréld le a szolgáltatónál —
#  a visszavonás ingyenes, a kár nem.
# ============================================================

# ---------- Supabase ----------
# A "Project Settings → API" oldalon találod mindkettőt.

# Ez a kulcs KIKERÜL a böngészőbe. Ez így van rendben: az RLS
# szabályok miatt ezzel csak a publikus adat érhető el.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ⚠ Ez a kulcs MEGKERÜLI az összes RLS szabályt: aki megszerzi,
# minden vendégadatot és foglalást lát. SOHA ne tedd "NEXT_PUBLIC_"
# előtaggal ellátott változóba, mert akkor a böngészőbe kerül.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------- SimplePay (OTP Mobil) ----------
